{
  "name": "Troll",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "TrollShared": {
        "$path": "src/shared",
        "WorldConfig": {
          "$path": "../config/world.json"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "TrollServer": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "TrollTools": {
        "$path": "src/tools"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "TrollClient": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 512,
        "StreamingTargetRadius": 2048
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true,
        "GeographicLatitude": 62.5
      }
    }
  }
}